# Browser-facing backend URL, inlined by Vite at frontend build time.
# In Docker, change it with: VITE_API_BASE_URL=http://host:port docker compose up --build
VITE_API_BASE_URL=http://localhost:4000

# Optional backend overrides (docker compose reads this file automatically).
BACKEND_PORT=4000
FRONTEND_PORT=3000
FAKESTORE_API_URL=https://fakestoreapi.com
FAKESTORE_TIMEOUT_MS=8000
CORS_ORIGIN=http://localhost:3000

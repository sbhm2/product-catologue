{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "types": ["node", "jest"],
    "noEmit": true,
    "declaration": false,
    "baseUrl": ".",
    "paths": {
      "@catalogue/contracts": ["../../packages/contracts/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "jest.config.ts"],
  "ts-node": {
    "compilerOptions": {
      "module": "CommonJS"
    }
  },
  "ignoreDeprecations": "6.0",
}
